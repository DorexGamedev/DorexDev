<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My First College Webpage</title>
    <style>
        /* 1. BASIC RESET: Clears default browser spacing */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        /* 2. BODY: Sets global background and color */
        body {
            background-color: #f4f7f6;
            color: #333;
            line-height: 1.6;
        }

        /* 3. HEADER & NAV: Positions logo and links horizontally */
        header {
            background-color: #2c3e50;
            color: #fff;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav a {
            color: #fff;
            text-decoration: none;
            margin-left: 1.5rem;
            font-weight: bold;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #1abc9c; /* Soft teal when hovered */
        }

        /* 4. HERO SECTION: Big eye-catching banner */
        .hero {
            background: linear-gradient(135deg, #1abc9c, #2c3e50);
            color: white;
            text-align: center;
            padding: 4rem 2rem;
        }

        .hero h2 {
            font-size: 2.5rem;
            margin-bottom: 0.5rem;
        }

        /* 5. CARDS GRID: Positions items side by side layout */
        .main-container {
            max-width: 1100px;
            margin: 3rem auto;
            padding: 0 1rem;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .card {
            background: white;
            padding: 2rem;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            border-top: 5px solid #1abc9c;
        }

        .card h3 {
            margin-bottom: 0.5rem;
            color: #2c3e50;
        }

        /* 6. BUTTON: Makes an anchor link look clickable */
        .btn {
            display: inline-block;
            background-color: #1abc9c;
            color: white;
            padding: 0.5rem 1rem;
            text-decoration: none;
            border-radius: 4px;
            margin-top: 1rem;
            transition: background 0.3s;
        }

        .btn:hover {
            background-color: #16a085;
        }

        /* 7. FOOTER: Anchors copyright text at the bottom */
        footer {
            text-align: center;
            padding: 2rem;
            background-color: #2c3e50;
            color: white;
            margin-top: 4rem;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <h1>My College Project</h1>
        <nav>
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </nav>
    </header>

    <!-- Hero Banner -->
    <section class="hero">
        <h2>Learning Web Design</h2>
        <p>This is a simple layout using raw structural HTML and styled with CSS.</p>
    </section>

    <!-- Main Content Area with Design Cards -->
    <main class="main-container">
        <div class="grid">
            
            <div class="card">
                <h3>HTML Component</h3>
                <p>HTML builds out your layout frame. It positions your navigation, text nodes, and container blocks.</p>
                <a href="#" class="btn">Learn More</a>
            </div>

            <div class="card">
                <h3>CSS Polish</h3>
                <p>CSS changes properties like fonts, color, shadows, and spaces. Hover over the links to see changes!</p>
                <a href="#" class="btn">Learn More</a>
            </div>

        </div>
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 First Web Interface. Open source template.</p>
    </footer>

</body>
</html>
